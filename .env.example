# Frontend
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173

# Backend
APP_ENV=development
APP_NAME=ML Systems Portfolio API
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
CORS_ORIGINS=http://localhost:5173
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=900
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO

# Optional email notification provider. Leave blank to disable notifications.
MAIL_PROVIDER=
MAIL_FROM=
MAIL_TO=
MAIL_API_KEY=

# Docker Compose host bindings. Change these if local ports are occupied.
COMPOSE_API_HOST_PORT=8000
COMPOSE_FRONTEND_HOST_PORT=5173
COMPOSE_API_URL=http://localhost:8000
COMPOSE_FRONTEND_ORIGIN=http://localhost:5173
MIGRATION_RETRIES=30
MIGRATION_RETRY_SECONDS=2
